<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinSetupPro.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinSetupPro.App.Converters"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        SelectionChanged="Nav_SelectionChanged">
        <NavigationView.PaneHeader>
            <StackPanel
                Margin="16,12,0,4"
                Orientation="Horizontal"
                Spacing="10">
                <Border
                    Width="32"
                    Height="32"
                    Background="White"
                    CornerRadius="8">
                    <Image
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/AppLogo.png"
                        Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="WinSetupPro" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.6"
                        Text="v0.1.0" />
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <!-- Text-only items: guaranteed to render on every machine. -->
            <NavigationViewItem x:Name="CatalogItem" Tag="catalog">
                <NavigationViewItem.Content>
                    <TextBlock Text="{x:Bind ViewModel.Loc.Get('catalog'), Mode=OneWay}" />
                </NavigationViewItem.Content>
            </NavigationViewItem>
            <NavigationViewItem x:Name="QueueItem" Tag="queue" automation:AutomationProperties.Name="Очередь">
                <NavigationViewItem.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.Loc.Get('queue'), Mode=OneWay}" VerticalAlignment="Center" />
                        <Border
                            Background="{StaticResource HeroGradient}"
                            CornerRadius="10"
                            Padding="8,2"
                            Visibility="{x:Bind ViewModel.QueueBadgeVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Text="{x:Bind ViewModel.QueueBadge, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White" />
                        </Border>
                    </StackPanel>
                </NavigationViewItem.Content>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Tag="settings">
                <NavigationViewItem.Content>
                    <TextBlock Text="{x:Bind ViewModel.Loc.Get('settings'), Mode=OneWay}" />
                </NavigationViewItem.Content>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <NavigationView.PaneFooter>
            <TextBlock
                Margin="16,0,16,12"
                FontSize="12"
                Opacity="0.6"
                Text="{x:Bind ViewModel.Loc.Get('footerHint'), Mode=OneWay}"
                TextWrapping="Wrap" />
        </NavigationView.PaneFooter>

        <Frame x:Name="ContentFrame">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition>
                        <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            <DrillInNavigationTransitionInfo />
                        </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    </NavigationThemeTransition>
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
    </NavigationView>
</Page>
