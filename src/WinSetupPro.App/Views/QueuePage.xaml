<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinSetupPro.App.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinSetupPro.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WinSetupPro.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </Page.Resources>

    <!-- No outer ScrollViewer: ListView keeps virtualization (no lag). -->
    <Grid Padding="24,20,24,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Background="{StaticResource HeroGradientSoft}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="24">
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Bind ViewModel.Loc.Get('queue'), Mode=OneWay}" />
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.NeedsAdmin, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Loc.Get('needAdmin'), Mode=OneWay}"
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button
                            Command="{x:Bind ViewModel.RestartAsAdminCommand}"
                            Content="{x:Bind ViewModel.Loc.Get('restartAdmin'), Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <ProgressBar
                    Maximum="100"
                    Value="{x:Bind ViewModel.OverallProgress, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        MinWidth="150"
                        Command="{x:Bind ViewModel.RunAllCommand}"
                        Content="{x:Bind ViewModel.Loc.Get('runAll'), Mode=OneWay}"
                        Style="{StaticResource BrandAccentButton}" />
                    <Button
                        MinWidth="120"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Content="{x:Bind ViewModel.Loc.Get('cancel'), Mode=OneWay}" />
                    <Button
                        MinWidth="150"
                        Command="{x:Bind ViewModel.ClearFinishedCommand}"
                        Content="{x:Bind ViewModel.Loc.Get('clearFinished'), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="JobsList"
                ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:JobItemViewModel">
                        <Border
                            Margin="0,4"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource PremiumCard}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="40"
                                    Height="40"
                                    Background="{x:Bind Tile.Background, Mode=OneWay}"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{x:Bind Tile.Text, Mode=OneWay}"
                                            Visibility="{x:Bind Tile.HasIcon, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                        <Image
                                            Width="28"
                                            Height="28"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind Tile.HasIcon, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <Image.Source>
                                                <SvgImageSource
                                                    RasterizePixelWidth="56"
                                                    UriSource="{x:Bind Tile.IconUri, Mode=OneWay}" />
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock
                                        MaxLines="1"
                                        Text="{x:Bind DisplayName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        FontWeight="SemiBold" />
                                    <TextBlock Opacity="0.75" Text="{x:Bind StatusText, Mode=OneWay}" />
                                    <ProgressBar
                                        Maximum="100"
                                        Value="{x:Bind Progress, Mode=OneWay}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock
                                        MaxLines="1"
                                        Opacity="0.6"
                                        Text="{x:Bind LogTail, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Click="RemoveJob_Click"
                                    Content="&#x00D7;"
                                    FontSize="16"
                                    Tag="{x:Bind Item.Id, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Grid.Column="1"
                Style="{StaticResource PremiumCard}"
                VerticalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <ScrollViewer>
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.LiveLog, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- Empty state -->
            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.Loc.Get('emptyQueue'), Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    MinWidth="200"
                    HorizontalAlignment="Center"
                    Click="Back_Click"
                    Content="{x:Bind ViewModel.Loc.Get('backToCatalog'), Mode=OneWay}"
                    Style="{StaticResource BrandAccentButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
