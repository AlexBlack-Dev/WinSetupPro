<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinSetupPro.App.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinSetupPro.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WinSetupPro.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <Storyboard x:Name="HeroEntrance">
            <DoubleAnimation
                Storyboard.TargetName="HeroPanel"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.5" />
            <DoubleAnimation
                Storyboard.TargetName="HeroTranslate"
                Storyboard.TargetProperty="Y"
                From="20"
                To="0"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <!-- NOTE: header lives INSIDE the GridView so item virtualization stays on (no lag). -->
        <GridView
            x:Name="CardsView"
            Padding="24,20,24,32"
            ItemsSource="{x:Bind ViewModel.Main.Filtered, Mode=OneWay}"
            SelectionMode="None">
            <GridView.Header>
                <StackPanel Margin="0,0,0,16" Spacing="16">
                    <!-- Hero -->
                    <Border
                        x:Name="HeroPanel"
                        Background="{StaticResource HeroGradientSoft}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Opacity="0"
                        Padding="24">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="HeroTranslate" />
                        </Border.RenderTransform>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Style="{StaticResource SectionTitle}"
                                    Text="{x:Bind ViewModel.Loc.Get('heroTitle'), Mode=OneWay}" />
                                <TextBlock
                                    Opacity="0.75"
                                    Text="{x:Bind ViewModel.Loc.Get('heroSubtitle'), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontWeight="SemiBold"
                                    Opacity="0.85"
                                    Text="{x:Bind ViewModel.Main.SelectionSummary, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="{x:Bind ViewModel.Main.CatalogStats, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="96"
                                Height="96"
                                Background="White"
                                CornerRadius="24"
                                VerticalAlignment="Center">
                                <Image
                                    Width="76"
                                    Height="76"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="ms-appx:///Assets/AppLogo.png"
                                    Stretch="Uniform" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Search (debounced in code-behind: no re-layout on every keystroke) -->
                    <TextBox
                        x:Name="SearchBox"
                        PlaceholderText="{x:Bind ViewModel.Loc.Get('search'), Mode=OneWay}"
                        Text="{x:Bind ViewModel.Main.SearchQuery, Mode=OneWay}"
                        TextChanged="SearchBox_TextChanged" />

                    <!-- Profile chips: horizontal scroll, never reflows the page -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Opacity="0.8"
                            Text="{x:Bind ViewModel.Loc.Get('profile'), Mode=OneWay}" />
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Main.ProfileChips, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ProfileChipViewModel">
                                        <Button Click="ProfileChip_Click" Tag="{x:Bind Id, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind DisplayWithCount, Mode=OneWay}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                MinWidth="120"
                                Click="Clear_Click"
                                Content="{x:Bind ViewModel.Loc.Get('clearSelection'), Mode=OneWay}" />
                    <Button
                        MinWidth="240"
                        Click="Install_Click"
                        Content="{x:Bind ViewModel.Loc.Get('installSelected'), Mode=OneWay}"
                        Style="{StaticResource BrandAccentButton}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GridView.Header>

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemHeight="156" ItemWidth="336" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                </TransitionCollection>
            </GridView.ItemContainerTransitions>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:AppItemViewModel">
                    <!-- Fixed 320×140: any language fits, nothing shifts. -->
                    <Border
                        Width="320"
                        Height="140"
                        Style="{StaticResource PremiumCard}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="52"
                                Height="52"
                                Background="{x:Bind Tile.Background, Mode=OneWay}"
                                CornerRadius="14"
                                VerticalAlignment="Top">
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{x:Bind Tile.Text, Mode=OneWay}"
                                        Visibility="{x:Bind Tile.HasIcon, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                    <Image
                                        Width="36"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        Visibility="{x:Bind Tile.HasIcon, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <Image.Source>
                                                <SvgImageSource
                                                    RasterizePixelWidth="72"
                                                    UriSource="{x:Bind Tile.IconUri, Mode=OneWay}" />
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Top">
                                <TextBlock
                                    MaxLines="1"
                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    MaxLines="2"
                                    Opacity="0.8"
                                    Text="{x:Bind DisplayDescription, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Padding="7,2">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind EngineLabel, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock
                                        MaxLines="1"
                                        Opacity="0.7"
                                        Text="{x:Bind CategoryLabel, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center"
                                        FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Empty state -->
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.6"
            Text="{x:Bind ViewModel.Loc.Get('emptyCatalog'), Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Main.IsFilteredEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Page>
