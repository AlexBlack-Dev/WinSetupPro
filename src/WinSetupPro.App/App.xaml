<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinSetupPro.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinSetupPro.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand: deep blue → vivid blue → sky (matches the cube logo) -->
            <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#1D4ED8" />
                <GradientStop Offset="0.55" Color="#2563EB" />
                <GradientStop Offset="1" Color="#38BDF8" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeroGradientSoft" StartPoint="0,0" EndPoint="1,1">
                <!-- NOTE: XAML hex is AARRGGBB (alpha first). -->
                <GradientStop Offset="0" Color="#331D4ED8" />
                <GradientStop Offset="1" Color="#3338BDF8" />
            </LinearGradientBrush>

            <!-- Brand primary button: fixed blue + white = 8:1 contrast in any theme. -->
            <Style x:Key="BrandAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="#2563EB" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#2563EB" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,8" />
            </Style>

            <!-- Card: rounded, layered, hover-lift handled in code-behind storyboards -->
            <Style x:Key="PremiumCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="30" />
            </Style>

            <Style x:Key="GlyphIcon" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
